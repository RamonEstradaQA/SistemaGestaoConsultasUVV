@model Consulta
@{ ViewData["Title"] = "Editar consulta"; }
<div class="form-card wide"><h1>Editar consulta</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Especialidade"></label><input asp-for="Especialidade" /><span asp-validation-for="Especialidade" class="validation"></span>
    <label asp-for="DataHora"></label><input asp-for="DataHora" type="datetime-local" /><span asp-validation-for="DataHora" class="validation"></span>
    <label asp-for="Descricao"></label><textarea asp-for="Descricao" rows="5"></textarea><span asp-validation-for="Descricao" class="validation"></span>
    <div class="actions"><button class="button" type="submit">Salvar alterações</button><a class="button secondary" asp-action="Index">Cancelar</a></div>
</form></div>
