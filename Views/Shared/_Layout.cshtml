<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão de Consultas UVV</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="nav">
        <a class="brand" asp-controller="Home" asp-action="Index">UVV Consultas</a>
        <div class="nav-links">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Consultas" asp-action="Index">Minhas consultas</a>
                <a asp-controller="Consultas" asp-action="Create">Nova consulta</a>
                <span class="user">Olá, @User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="link-button">Sair</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Entrar</a>
                <a class="button small" asp-controller="Account" asp-action="Register">Criar conta</a>
            }
        </div>
    </nav>
</header>
<main class="container">
    @if (TempData["Mensagem"] is string mensagem)
    {
        <div class="alert success">@mensagem</div>
    }
    @RenderBody()
</main>
<footer>Projeto acadêmico — Desenvolvimento Web Back-end — UVV</footer>
</body>
</html>
